<?xml version="1.0"?>

<robot name="rover">

  <!--
    base_link is the main reference frame of the rover.
    It lies approximately at ground level in the centre of the chassis.
  -->

  <link name="base_link"/>

  <!-- Main chassis -->

  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>

      <geometry>
        <box size="0.80 0.55 0.20"/>
      </geometry>

      <material name="chassis_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>

      <geometry>
        <box size="0.80 0.55 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <mass value="10.0"/>

      <inertia
        ixx="0.285"
        ixy="0.0"
        ixz="0.0"
        iyy="0.567"
        iyz="0.0"
        izz="0.686"/>
    </inertial>
  </link>

  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Left front wheel -->

  <link name="left_front_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>

      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <material name="wheel_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="left_front_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_front_wheel_link"/>
    <origin xyz="0.28 0.31 0.15" rpy="0 0 0"/>
  </joint>

  <!-- Right front wheel -->

  <link name="right_front_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>

      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <material name="wheel_black"/>
    </visual>
  </link>

  <joint name="right_front_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_front_wheel_link"/>
    <origin xyz="0.28 -0.31 0.15" rpy="0 0 0"/>
  </joint>

  <!-- Left rear wheel -->

  <link name="left_rear_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>

      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <material name="wheel_black"/>
    </visual>
  </link>

  <joint name="left_rear_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_rear_wheel_link"/>
    <origin xyz="-0.28 0.31 0.15" rpy="0 0 0"/>
  </joint>

  <!-- Right rear wheel -->

  <link name="right_rear_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>

      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <material name="wheel_black"/>
    </visual>
  </link>

  <joint name="right_rear_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_rear_wheel_link"/>
    <origin xyz="-0.28 -0.31 0.15" rpy="0 0 0"/>
  </joint>

  <!-- Simple sensor mast -->

  <link name="sensor_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.06" length="0.20"/>
      </geometry>

      <material name="sensor_gray">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="sensor_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="sensor_link"/>
    <origin xyz="0.15 0 0.28" rpy="0 0 0"/>
  </joint>

</robot>
